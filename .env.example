# For dbt (profiles.yml), Dagster and docker compose. Each ingestion source has its own .env.
WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5432
WAREHOUSE_USER=elt
WAREHOUSE_PASSWORD=elt
WAREHOUSE_DB=warehouse

# Schema the ingestion layer writes raw tables into. dbt reads from here.
RAW_SCHEMA=raw
# Schema dbt builds models into.
DBT_SCHEMA=analytics

# eRPC proxy (infra/erpc). Clients use http://localhost:${ERPC_PORT}/main/evm/1
ERPC_PORT=4000
ERPC_METRICS_PORT=4001

# Dshackle proxy for Bitcoin (infra/dshackle). Clients use http://localhost:${DSHACKLE_PORT}/bitcoin
DSHACKLE_PORT=8545
DSHACKLE_HEALTH_PORT=8082

# Monitoring (infra/prometheus, infra/grafana). Grafana is not on 3000 because Dagster uses it.
PUSHGATEWAY_PORT=9091
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
# Password of the read-only warehouse role that Grafana and postgres-exporter log in as.
MONITOR_PASSWORD=monitor

# Each ingestion run pushes its metrics here (infra/docker-compose.yml). Leave it empty to push none.
PUSHGATEWAY_URL=http://localhost:9091
# trace, debug, info, warn, error, fatal or silent.
LOG_LEVEL=info

# A Portal API key, which every stream source sends with its Portal requests. Leave it empty to read the
# public Portal without one, at its anonymous limits.
PORTAL_API_KEY=

# Google Drive, for bj report --format gdoc. Set one of the two to the path of a JSON file: an OAuth client
# ID of type Desktop app (bj caches its token in ~/.config/blockjuice/), or a service account key. bj asks
# for the drive.file scope, which reaches only the Docs bj creates.
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_APPLICATION_CREDENTIALS=
# The Drive folder new Docs go into. Without it they go to the root of My Drive. A service account has no
# Drive storage of its own, so it needs a folder in a shared drive.
# GOOGLE_DRIVE_FOLDER_ID=

WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5432
WAREHOUSE_USER=elt
WAREHOUSE_PASSWORD=elt
WAREHOUSE_DB=warehouse
RAW_SCHEMA=raw

# Binance's market-data-only host. api.binance.com refuses requests from some regions.
BINANCE_API_URL=https://data-api.binance.vision
# The candle length: 1m, 3m, 5m, 15m, 30m, 1h, 2h, 4h, 6h, 8h, 12h, 1d, 3d or 1w.
CANDLE_INTERVAL=1h
# An ISO date or datetime, in UTC unless it carries an offset. Each run loads every closed candle since then.
START_TIME=2026-10-01T00:00:00Z
# Requests in flight at once, at most 100. Binance allows 6000 request weight a minute per IP; a request for candles weighs 2.
BINANCE_MAX_CONCURRENCY=5

# Each ingestion run pushes its metrics here (infra/docker-compose.yml). Leave it empty to push none.
PUSHGATEWAY_URL=http://localhost:9091
# trace, debug, info, warn, error, fatal or silent.
LOG_LEVEL=info

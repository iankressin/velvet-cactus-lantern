WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5432
WAREHOUSE_USER=elt
WAREHOUSE_PASSWORD=elt
WAREHOUSE_DB=warehouse
RAW_SCHEMA=raw

# Solana RPCs serve only current state, so each run reads the latest finalized slot.
SOLANA_RPC_URL=http://localhost:4000/main/solana

# The wallet asset CSV the balance sources share, by its path from this package's folder. This source
# reads the mints in its solana spl rows.
WALLET_ASSETS_CSV=../../../input/wallet-assets.csv

# Each ingestion run pushes its metrics here (infra/docker-compose.yml). Leave it empty to push none.
PUSHGATEWAY_URL=http://localhost:9091
# trace, debug, info, warn, error, fatal or silent.
LOG_LEVEL=info

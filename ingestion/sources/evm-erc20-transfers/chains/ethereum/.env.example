# The Portal dataset to stream from.
PORTAL_URL=https://portal.sqd.dev/datasets/ethereum-mainnet
# Where the first run starts; later runs resume after the cursor in raw._sync. This is the first
# block of 2026-11-01 UTC. These wallets see about 32,000 transfers a day, so an earlier block
# means many more rows. USDT, the oldest token here, was deployed at block 4634748.
START_BLOCK=26316189

# Settings every chain shares. Each chain's EVM_RPC_URL is in chains/<chain>/.env.example, and a chain's
# .env next to it overrides it. chains/<chain>/addresses.json lists the tokens whose name, symbol and
# decimals to read. On Ethereum it also reads every token in the erc20 rows of WALLET_ASSETS_CSV.
WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5432
WAREHOUSE_USER=elt
WAREHOUSE_PASSWORD=elt
WAREHOUSE_DB=warehouse
RAW_SCHEMA=raw

# A block number, or latest, safe or finalized. A tag is read once at the start of each run, so every
# token in the run is read at the same block. A past block needs an archive node.
BLOCK_NUMBER=latest
# Most calls per JSON-RPC batch. Public RPCs refuse large batches.
RPC_BATCH_SIZE=10
# Most requests in flight at once. Public RPCs answer 429 or time out above a few.
RPC_MAX_CONCURRENCY=2

# The wallet asset CSV the balance sources share, by its path from this package's folder. Chains it
# cannot hold yet, such as base, do not read it.
WALLET_ASSETS_CSV=../../wallet-assets.csv

# Each ingestion run pushes its metrics here (infra/docker-compose.yml). Leave it empty to push none.
PUSHGATEWAY_URL=http://localhost:9091
# trace, debug, info, warn, error, fatal or silent.
LOG_LEVEL=info

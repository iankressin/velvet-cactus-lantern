WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5432
WAREHOUSE_USER=elt
WAREHOUSE_PASSWORD=elt
WAREHOUSE_DB=warehouse
RAW_SCHEMA=raw

# Coinbase Exchange's public market-data API. Its market data needs no key.
COINBASE_API_URL=https://api.exchange.coinbase.com
# The candle length: 1m, 5m, 15m, 1h, 6h or 1d, the granularities Coinbase offers.
CANDLE_INTERVAL=1h
# An ISO date or datetime, in UTC unless it carries an offset. Each run loads every closed candle since then.
START_TIME=2026-10-01T00:00:00Z
# Requests in flight at once, at most 10. Coinbase allows 10 public requests a second per IP, and a run sends one chunk a second.
COINBASE_MAX_CONCURRENCY=5

# Each ingestion run pushes its metrics here (infra/docker-compose.yml). Leave it empty to push none.
PUSHGATEWAY_URL=http://localhost:9091
# trace, debug, info, warn, error, fatal or silent.
LOG_LEVEL=info

# The Portal dataset to stream from.
PORTAL_URL=https://portal.sqd.dev/datasets/ethereum-mainnet
# The first block of pool creations. Pipes' factory pattern must see every pool of the tokens in
# addresses.json, including those created long before START_BLOCK, since they still trade. 17046833
# holds PEPE's first Uniswap pool (proof row 1 in catalog/protocols/uniswap/NOTES.md); the scan of all
# three factories behind those notes found no PEPE pool earlier. Unset, it is the factory's deploy
# block, 12369621. A token added to addresses.json may need an earlier block, and a reset. The first
# runs, about a million blocks each, read pool creations only, until they reach START_BLOCK.
POOLS_START_BLOCK=17046833
# The first block of Swaps: the first block of 2026-10-01 UTC, from "Time window used for checks" in
# catalog/protocols/uniswap/NOTES.md. Later runs resume after the cursor in raw._sync.
START_BLOCK=26093738
# The last block to read. Set it only to check a short window; runs read to Portal's finalized head.
# END_BLOCK=
# Where Pipes' factory pattern keeps the pools it has found, relative to the package. It holds what
# the runs before the cursor learned, so it goes with the cursor: delete it whenever you reset the
# source (raw._sync row and raw table), and never on its own. A run that resumes with a new file fails.
FACTORY_DB=chains/ethereum/factory.sqlite

# Settings every chain shares. Each chain's EVM_RPC_URL and RPC_BATCH_SIZE are in
# chains/<chain>/.env.example, and a chain's .env next to it overrides them. Each chain reads its
# wallets and tokens from its erc20 rows in WALLET_ASSETS_CSV.

WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5432
WAREHOUSE_USER=elt
WAREHOUSE_PASSWORD=elt
WAREHOUSE_DB=warehouse
RAW_SCHEMA=raw

# A block number, or latest, safe or finalized. A tag is read once at the start of each run.
BLOCK_NUMBER=finalized

# The wallet asset CSV every balance source shares, by its path from this package's folder; each chain reads its own rows.
WALLET_ASSETS_CSV=../../../input/wallet-assets.csv

# Each ingestion run pushes its metrics here (infra/docker-compose.yml). Leave it empty to push none.
PUSHGATEWAY_URL=http://localhost:9091
# trace, debug, info, warn, error, fatal or silent.
LOG_LEVEL=info
